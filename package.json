{
  "name": "joint-motion-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests *.ts *.json index.html .github/workflows/*.yml docs/*.md README.md",
    "format:check": "prettier --check src tests *.ts *.json index.html .github/workflows/*.yml docs/*.md README.md"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
